# Copy this file to .env and fill in real values. Never commit .env.

# Apify tokens: from https://console.apify.com/settings/integrations
# The engine checks quota in order and falls back to the next token when one is exhausted.
# At least APIFY_TOKEN is required; the rest are optional but recommended.
APIFY_TOKEN=
APIFY_TOKEN_2=
APIFY_TOKEN_3=
APIFY_TOKEN_4=
APIFY_TOKEN_5=

# Google Cloud OAuth client: create at https://console.cloud.google.com/apis/credentials
# (Application type: Desktop app). Enable the Gmail API on the project first.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Obtained by running: node get-refresh-token.js  (one-time, see README)
GOOGLE_REFRESH_TOKEN=

# Recipient
TO_EMAIL=

# Groq API key - used for LLM-based JD experience filtering
# Models tried in order: openai/gpt-oss-120b -> qwen/qwen3.8-27b -> groq/compound -> openai/gpt-oss-20b
GROQ_API_KEY=
